+                    .set_format(KeyFormat::Pem)
+                    .set_structure(Structure::SubjectPublicKeyInfo)
+                    .encode(&pkey)
+                    .unwrap();
+
+                // Check that we have a public key PEM, and that we can load it back
+                let pem_str = from_utf8(&pem).unwrap();
