+        let secret_key = b"secret0123456789";
+        let digest = MessageDigest::sha1();
+
+        ctx.init_digest(secret_key, &digest).unwrap();
+        ctx.update(b"foobar").unwrap();
+        let hash = ctx.finalize_to_vec().unwrap();
